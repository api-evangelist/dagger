    "CacheVolume": "dagger:CacheVolume",
    "Daggerverse": "dagger:Daggerverse",
    "DaggerCloud": "dagger:DaggerCloud",
    "id": "@id",
    "type": "@type",
    "name": "schema:name",
    "ref": "dagger:ref",
